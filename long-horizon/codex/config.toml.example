# Copy/merge into .codex/config.toml or ~/.codex/config.toml as appropriate.
[features]
goals = true

[agents]
enabled = true
max_concurrent_threads_per_session = 12
# Leave model unset to inherit the parent unless you intentionally choose a cheaper worker model.
# default_subagent_model = "gpt-5.6"
# default_subagent_reasoning_effort = "medium"
interrupt_message = true
