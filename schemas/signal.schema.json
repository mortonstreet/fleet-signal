{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal",
  "type": "object",
  "required": [
    "id",
    "offer",
    "event_ids",
    "score",
    "tier",
    "reason_codes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "offer": {
      "type": "string"
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entity_id": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "tier": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "object"
    },
    "score_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}