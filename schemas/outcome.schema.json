{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outcome",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "offer",
    "signal_id",
    "status",
    "recorded_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "offer": {
      "type": "string"
    },
    "signal_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}